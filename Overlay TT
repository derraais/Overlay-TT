            text-shadow: 0 0 8px rgba(0, 242, 254, 0.7), 0 0 16px rgba(255, 0, 80, 0.7);
        }

        .neon-box-glow {
            box-shadow: 0 0 20px rgba(0, 242, 254, 0.25), 0 0 30px rgba(255, 0, 80, 0.25);
        }

