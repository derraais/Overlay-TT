    <!-- JAVASCRIPT AUDIO & INTERACTIVE LOGIC -->
    <script>
        // Web Audio API Sound Effects Synthesizer (No external sound files required)
        function playAudioAlert(type) {
            try {
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                
                if (type === 'follower') {
                    // Upbeat Chime Sound Effect
                    const now = ctx.currentTime;
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(523.25, now); // C5
                    osc.frequency.exponentialRampToValueAtTime(659.25, now + 0.1); // E5
                    osc.frequency.exponentialRampToValueAtTime(783.99, now + 0.2); // G5
                    osc.frequency.exponentialRampToValueAtTime(1046.50, now + 0.3); // C6
                    
                    gain.gain.setValueAtTime(0.3, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.5);
                    
                    osc.connect(gain);
                    gain.connect(ctx.destination);
                    
                    osc.start(now);
                    osc.stop(now + 0.5);
                } else if (type === 'gift') {
                    // Fanfare Super Sound Effect
                    const now = ctx.currentTime;
                    [523.25, 659.25, 783.99, 1046.50].forEach((freq, idx) => {
                        const osc = ctx.createOscillator();
                        const gain = ctx.createGain();
                        
                        osc.type = 'triangle';
                        osc.frequency.setValueAtTime(freq, now + idx * 0.08);
                        
                        gain.gain.setValueAtTime(0.25, now + idx * 0.08);
                        gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.08 + 0.4);
                        
                        osc.connect(gain);
                        gain.connect(ctx.destination);
                        
                        osc.start(now + idx * 0.08);
                        osc.stop(now + idx * 0.08 + 0.4);
                    });
                }
            } catch (e) {
                console.log('Audio Context Error:', e);
            }
        }

        // Update Profile Info
        function updateProfile() {
            const name = document.getElementById('inputName').value;
            document.getElementById('dispStreamerName').innerText = name || '@Streamer';
        }

        // Update Announcement
        function updateAnnouncement() {
            const text = document.getElementById('inputAnnouncement').value;
            document.getElementById('dispAnnouncement').innerText = text || 'Follow & Share ya!';
        }

        // Update Goal Bar Info
        function updateGoal() {
            const title = document.getElementById('inputGoalTitle').value;
            const current = parseInt(document.getElementById('inputGoalCurrent').value) || 0;
            const max = parseInt(document.getElementById('inputGoalMax').value) || 1000;

            const percentage = Math.min(Math.max((current / max) * 100, 0), 100);

            document.getElementById('dispGoalTitle').innerHTML = `<i class="fa-solid fa-trophy text-yellow-400"></i> ${title}`;
            document.getElementById('dispGoalValues').innerText = `${current} / ${max}`;
            document.getElementById('dispGoalProgress').style.width = `${percentage}%`;
        }

        // Update Social Media Handles
        function updateSocials() {
            document.getElementById('dispSocialTt').innerText = document.getElementById('inputSocialTt').value || '@tiktok';
            document.getElementById('dispSocialIg').innerText = document.getElementById('inputSocialIg').value || '@instagram';
            document.getElementById('dispSocialYt').innerText = document.getElementById('inputSocialYt').value || 'YouTube';
        }

        // Toggle Element Visibility
        function toggleElement(elementId) {
            const el = document.getElementById(elementId);
            if (el) {
                el.classList.toggle('hidden');
            }
        }

        // Switch Canvas Background Mode (Game / Green Screen)
        function setCanvasBg(mode) {
            const bgMock = document.getElementById('bgMock');
            const bgOverlay = document.getElementById('bgGradientOverlay');
            const btnGame = document.getElementById('btnBgGame');
            const btnChroma = document.getElementById('btnBgChroma');

            if (mode === 'chroma') {
                bgMock.style.backgroundImage = 'none';
                bgMock.classList.add('bg-chroma-key');
                bgOverlay.classList.add('hidden');

                btnChroma.className = "p-2 rounded-xl bg-green-500/20 border border-green-500 text-xs font-bold text-center text-green-400";
                btnGame.className = "p-2 rounded-xl bg-black border border-white/10 hover:bg-neutral-800 text-xs font-bold text-center text-gray-300";
            } else {
                bgMock.classList.remove('bg-chroma-key');
                bgMock.style.backgroundImage = "url('https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=1000&q=80')";
                bgOverlay.classList.remove('hidden');

                btnGame.className = "p-2 rounded-xl bg-ttCyan/20 border border-ttCyan text-xs font-bold text-center text-ttCyan";
                btnChroma.className = "p-2 rounded-xl bg-black border border-white/10 hover:bg-neutral-800 text-xs font-bold text-center text-gray-300";
