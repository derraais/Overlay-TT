    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;600;800;900&display=swap" rel="stylesheet">
    <!-- Animate.css for alert popups -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        display: ['Outfit', 'sans-serif'],
                    },
                    colors: {
                        ttRed: '#FF0050',
                        ttCyan: '#00F2FE',
                        ttDark: '#121212',
                    },
                    animation: {
                        'pulse-glow': 'pulseGlow 2s infinite',
                        'marquee': 'marquee 18s linear infinite',
                        'float': 'float 3s ease-in-out infinite',
                    },
                    keyframes: {
                        pulseGlow: {
                            '0%, 100%': { boxShadow: '0 0 15px rgba(0, 242, 254, 0.6), 0 0 30px rgba(255, 0, 80, 0.4)' },
                            '50%': { boxShadow: '0 0 25px rgba(0, 242, 254, 0.9), 0 0 45px rgba(255, 0, 80, 0.7)' },
                        },
                        marquee: {
                            '0%': { transform: 'translateX(100%)' },
                            '100%': { transform: 'translateX(-100%)' },
                        },
                        float: {
                            '0%, 100%': { transform: 'translateY(0)' },
                            '50%': { transform: 'translateY(-6px)' },
                        }
                    }
                }
            }
        }
    </script>

    <style>
